---
import CimaLayout from "../layouts/CimaLayout.astro";
import HorizontalRail from "../components/molecules/HorizontalRail.astro";
import MediaCard from "../components/molecules/MediaCard.astro";
import EpisodeCard from "../components/molecules/EpisodeCard.astro";
import { getEmDashCollection, getEntriesByTerm, getTaxonomyTerms } from "emdash";

// Icon mapping for genres
const genreIcons: Record<string, string> = {
	action: "💥",
	adventure: "🧭",
	drama: "🎭",
	comedy: "😂",
	crime: "🕵️",
	thriller: "⚡",
	horror: "👻",
	romance: "💖",
	fantasy: "🏰",
	mystery: "🔍",
	family: "👨‍👩‍👧‍👦",
	history: "📜",
	war: "⚔️",
	"sci-fi": "🚀",
};

// Fetch Movies, TV, Episodes, and All Genre Sections
let movies: any[] = [];
let tvSeries: any[] = [];
let episodesWithSeries: any[] = [];
let movieGenreSections: { slug: string; label: string; entries: any[] }[] = [];
let tvGenreSections: { slug: string; label: string; entries: any[] }[] = [];

try {
	const [moviesRes, tvRes, epRes, allGenresRes] = await Promise.all([
		getEmDashCollection("movies", { limit: 14, orderBy: { created_at: "desc" } }),
		getEmDashCollection("tv", { limit: 14, orderBy: { created_at: "desc" } }),
		getEmDashCollection("episodes", { limit: 12, orderBy: { created_at: "desc" } }),
		getTaxonomyTerms("genre").catch(() => []),
	]);

	movies = moviesRes.entries || [];
	tvSeries = tvRes.entries || [];
	const rawEpisodes = epRes.entries || [];
	const allGenres = Array.isArray(allGenresRes) ? allGenresRes : [];

	if (Astro.cache?.enabled) {
		if (moviesRes.cacheHint) Astro.cache.set(moviesRes.cacheHint);
		if (tvRes.cacheHint) Astro.cache.set(tvRes.cacheHint);
		if (epRes.cacheHint) Astro.cache.set(epRes.cacheHint);
	}

	// Map each episode to its parent series using slug prefix matching
	episodesWithSeries = rawEpisodes.map((ep: any) => {
		const matchedSeries = tvSeries.find((t: any) => ep.id.startsWith(t.id + "-"));
		const series = matchedSeries ?? tvSeries[0];
		const seasonMatch = ep.id.match(/season-(\d+)/);
		const seasonNumber = seasonMatch ? parseInt(seasonMatch[1], 10) : 1;

		return {
			...ep,
			seriesPoster: series?.data?.featured_image,
			seriesSlug: series?.id ?? "",
			seasonNumber,
			seriesTitle: series?.data?.title ?? "",
		};
	});

	// Dynamically query all movie genres and all TV genres that contain entries
	const movieGenrePromises = allGenres.map(async (g: any) => {
		let entries = await getEntriesByTerm("movies", "movie_genre", g.slug).catch(() => []);
		if (!Array.isArray(entries) || entries.length === 0) {
			entries = await getEntriesByTerm("movies", "genre", g.slug).catch(() => []);
		}
		return {
			slug: g.slug,
			label: g.label,
			entries: Array.isArray(entries) ? entries : [],
		};
	});

	const tvGenrePromises = allGenres.map(async (g: any) => {
		let entries = await getEntriesByTerm("tv", "tv_genre", g.slug).catch(() => []);
		if (!Array.isArray(entries) || entries.length === 0) {
			entries = await getEntriesByTerm("tv", "genre", g.slug).catch(() => []);
		}
		return {
			slug: g.slug,
			label: g.label,
			entries: Array.isArray(entries) ? entries : [],
		};
	});

	const [movieGenreResults, tvGenreResults] = await Promise.all([
		Promise.all(movieGenrePromises),
		Promise.all(tvGenrePromises),
	]);

	movieGenreSections = movieGenreResults.filter((g) => g.entries.length > 0);
	tvGenreSections = tvGenreResults.filter((g) => g.entries.length > 0);

} catch (e) {
	console.error("Error fetching homepage content:", e);
}
---

<CimaLayout title="معاك سيما | مشاهدة أحدث الأفلام والمسلسلات أونلاين">
	<div class="md3-container pt-6">

		<!-- Homepage SEO Main Heading & Subtitle -->
		<div class="mb-8 border-b border-[var(--color-border)] pb-4">
			<h1 class="text-xl md:text-2xl font-black text-[var(--color-text)] tracking-tight">
				معاك سيما — مشاهدة أحدث الأفلام والمسلسلات العربية والأجنبية أونلاين
			</h1>
			<p class="text-xs md:text-sm text-[var(--color-text-secondary)] mt-1.5">
				دليلك الشامل لمشاهدة وتحميل أقوى الأفلام الحصرية وأحدث حلقات المسلسلات بأعلى جودة Full HD
			</p>
		</div>

		<!-- 1. أحدث الأفلام المضافة (Zero-JS Full Width Horizontal Rail) -->
		<HorizontalRail
			title="أحدث الأفلام المضافة"
			icon="🔥"
			viewAllHref="/movies"
		>
			{movies.map((movie, idx) => (
				<MediaCard
					title={movie.data.title}
					slug={movie.id}
					type="movie"
					image={movie.data.featured_image}
					release={movie.data.release}
					duration={movie.data.duration}
					priority={idx < 4}
					edit={movie.edit}
				/>
			))}
		</HorizontalRail>

		<!-- 2. أحدث المسلسلات المضافة -->
		<HorizontalRail
			title="أحدث المسلسلات المضافة"
			icon="📺"
			viewAllHref="/tv"
		>
			{tvSeries.map((series) => (
				<MediaCard
					title={series.data.title}
					slug={series.id}
					type="tv"
					image={series.data.featured_image}
					release={series.data.release}
					edit={series.edit}
				/>
			))}
		</HorizontalRail>

		<!-- 3. أحدث الحلقات المضافة (مع عرض بوستر المسلسل - Zero JS EpisodeCard) -->
		{episodesWithSeries.length > 0 && (
			<HorizontalRail
				title="أحدث الحلقات المضافة"
				icon="⚡"
				viewAllHref="/tv"
			>
				{episodesWithSeries.map((ep) => (
					<EpisodeCard
						title={ep.data.title || `الحلقة ${ep.data.episode_number}`}
						episodeNumber={ep.data.episode_number}
						duration={ep.data.duration}
						image={ep.seriesPoster}
						slug={ep.id}
						seriesSlug={ep.seriesSlug}
						seasonNumber={ep.seasonNumber}
					/>
				))}
			</HorizontalRail>
		)}

		<!-- 4. أقسام الأفلام حسب التصنيفات الفنية (Cards Horizontal Scroll - Minimal JS Policy) -->
		{movieGenreSections.map((sec) => (
			<HorizontalRail
				title={`أفلام ${sec.label}`}
				icon={genreIcons[sec.slug] || "🎬"}
				viewAllHref={`/movies/genre/${sec.slug}`}
			>
				{sec.entries.map((movie: any) => (
					<MediaCard
						title={movie.data.title}
						slug={movie.id}
						type="movie"
						image={movie.data.featured_image}
						release={movie.data.release}
						duration={movie.data.duration}
						edit={movie.edit}
					/>
				))}
			</HorizontalRail>
		))}

		<!-- 5. أقسام المسلسلات حسب التصنيفات الفنية (Cards Horizontal Scroll - Minimal JS Policy) -->
		{tvGenreSections.map((sec) => (
			<HorizontalRail
				title={`مسلسلات ${sec.label}`}
				icon={genreIcons[sec.slug] || "📺"}
				viewAllHref={`/tv/genre/${sec.slug}`}
			>
				{sec.entries.map((series: any) => (
					<MediaCard
						title={series.data.title}
						slug={series.id}
						type="tv"
						image={series.data.featured_image}
						release={series.data.release}
						edit={series.edit}
					/>
				))}
			</HorizontalRail>
		))}
	</div>
</CimaLayout>
