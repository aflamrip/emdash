---
export const prerender = false;

import { search } from "emdash";
import CimaLayout from "../layouts/CimaLayout.astro";
import MediaCard from "../components/molecules/MediaCard.astro";
import Breadcrumbs from "../components/molecules/Breadcrumbs.astro";

const query = Astro.url.searchParams.get("q")?.trim() || "";

let results: any[] = [];
if (query) {
	try {
		const res = await search(query, {
			collections: ["movies", "tv", "episodes", "people"],
			limit: 30,
		});
		results = res.items || [];
	} catch (e) {
		console.error("Search error:", e);
	}
}

const pageTitle = query ? `نتائج البحث عن: ${query} | معاك سيما` : "البحث السريع | معاك سيما";
---

<CimaLayout
	title={pageTitle}
	description={`نتائج البحث عن ${query} على معاك سيما`}
	robots="noindex,follow"
>
	<div class="md3-container pt-4">
		<!-- Breadcrumbs -->
		<Breadcrumbs items={[{ label: "البحث" }]} />

		<!-- Header -->
		<div class="my-6">
			<h1 class="text-2xl md:text-3xl font-extrabold text-[var(--color-text)] flex items-center gap-2">
				<span>🔍</span>
				<span>{query ? `نتائج البحث عن: "${query}"` : "البحث عن فيلم أو مسلسل أو فنان"}</span>
			</h1>
			<p class="text-muted text-sm mt-1">
				{results.length > 0
					? `تم العثور على ${results.length} نتيجة مطابقة لبحثك`
					: query
						? "لم يتم العثور على نتائج مطابقة، جرب كلمات بحث أخرى"
						: "اكتب اسم الفيلم أو المسلسل أو الفنان للبحث السريع"}
			</p>
		</div>

		<!-- Search Form -->
		<form method="get" action="/search" class="max-w-xl my-6 flex items-center gap-2">
			<input
				type="text"
				name="q"
				value={query}
				placeholder="ابحث عن فيلم، مسلسل، ممثل..."
				class="flex-1 bg-[var(--color-fill)] text-[var(--color-text)] text-sm rounded-xl py-2.5 px-4 border border-[var(--color-border)] focus:border-[var(--color-brand)] outline-none transition-all placeholder:text-muted"
			/>
			<button
				type="submit"
				class="bg-[var(--color-brand)] hover:bg-[var(--color-brand-hover)] text-[var(--color-on-brand)] text-sm font-bold px-6 py-2.5 rounded-xl transition-all shadow-md shadow-[var(--color-brand)]/20 cursor-pointer"
			>
				بحث
			</button>
		</form>

		<!-- Results Grid (Minimal JS with MediaCard.astro) -->
		{results.length > 0 ? (
			<div class="media-grid my-8">
				{results.map((item) => {
					const type = item.collection === "movies" ? "movie" : "tv";
					return (
						<MediaCard
							title={item.title || item.slug}
							slug={item.slug || item.id}
							type={type}
							image={item.featured_image}
							release={item.release}
						/>
					);
				})}
			</div>
		) : query ? (
			<div class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-2xl p-12 text-center text-muted my-8">
				لم نتمكن من العثور على أي نتائج تطابق "<span class="text-[var(--color-text)] font-semibold">{query}</span>".
			</div>
		) : null}
	</div>
</CimaLayout>
