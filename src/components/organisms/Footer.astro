---
import { getSiteSettings } from "emdash";

let settings = {
	title: "معاك سيما",
	tagline: "مشاهدة افلام ومسلسلات اونلاين",
};

try {
	const res = await getSiteSettings();
	if (res?.title) settings.title = res.title;
	if (res?.tagline) settings.tagline = res.tagline;
} catch (e) {
	// Fallback
}

const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-secondary)] py-10 text-sm select-none transition-colors duration-300">
	<div class="md3-container">
		<div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
			<!-- Col 1: Brand & Tagline -->
			<div class="md:col-span-2">
				<div class="flex items-center gap-2.5 mb-3">
					<div class="relative w-8 h-8 rounded-xl bg-gradient-to-br from-[#00e5ff]/25 to-[#0284c7]/30 border border-[#00e5ff]/60 flex items-center justify-center text-[#00e5ff] shadow-md shadow-[#00e5ff]/20">
						<svg class="w-4 h-4 fill-current filter drop-shadow-[0_0_6px_rgba(0,229,255,0.85)]" viewBox="0 0 24 24">
							<path d="M8 5v14l11-7z" />
						</svg>
					</div>
					<span class="text-xl font-black text-[var(--color-text)] tracking-tight">
						{settings.title}
					</span>
				</div>
				<p class="text-[var(--color-text-secondary)] text-xs md:text-sm leading-relaxed max-w-md">
					{settings.tagline} - منصتكم الأولى لمشاهدة أحدث الأفلام والمسلسلات العربية والأجنبية المترجمة بجودة فائقة Full HD مع سيرفرات تشغيل سريعة ومتوافقة مع جميع الأجهزة.
				</p>
			</div>

			<!-- Col 2: Navigation Links -->
			<div>
				<h4 class="text-[var(--color-text)] font-semibold mb-3 text-sm">روابط سريعة</h4>
				<ul class="space-y-2 text-xs">
					<li>
						<a href="/movies" class="hover:text-[var(--color-brand)] transition-colors">دليل الأفلام</a>
					</li>
					<li>
						<a href="/tv" class="hover:text-[var(--color-brand)] transition-colors">دليل المسلسلات</a>
					</li>
					<li>
						<a href="/category" class="hover:text-[var(--color-brand)] transition-colors">الأقسام الرئيسية</a>
					</li>
					<li>
						<a href="/genre" class="hover:text-[var(--color-brand)] transition-colors">التصنيفات الفنية</a>
					</li>
					<li>
						<a href="/rss.xml" class="hover:text-[var(--color-brand)] transition-colors">خلاصة RSS</a>
					</li>
				</ul>
			</div>

			<!-- Col 3: Categories & Sections -->
			<div>
				<h4 class="text-[var(--color-text)] font-semibold mb-3 text-sm">الأقسام الرئيسية</h4>
				<ul class="space-y-2 text-xs">
					<li>
						<a href="/category/movies-arabic" class="hover:text-[var(--color-text)] transition-colors">أفلام عربية</a>
					</li>
					<li>
						<a href="/category/movies-foreign" class="hover:text-[var(--color-text)] transition-colors">أفلام أجنبية مترجمة</a>
					</li>
					<li>
						<a href="/category/series-arabic" class="hover:text-[var(--color-text)] transition-colors">مسلسلات عربية</a>
					</li>
					<li>
						<a href="/category/series-foreign" class="hover:text-[var(--color-text)] transition-colors">مسلسلات أجنبية مترجمة</a>
					</li>
				</ul>
			</div>
		</div>

		<!-- Bottom Copyright Row -->
		<div class="border-t border-[var(--color-border)] pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-muted">
			<div>
				© {currentYear} {settings.title}. جميع الحقوق محفوظة.
			</div>
			<div class="flex items-center gap-4">
				<a href="/pages/privacy" class="hover:text-[var(--color-text)] transition-colors">سياسة الخصوصية</a>
				<span>•</span>
				<a href="/pages/terms" class="hover:text-[var(--color-text)] transition-colors">شروط الاستخدام</a>
				<span>•</span>
				<a href="/pages/contact" class="hover:text-[var(--color-text)] transition-colors">اتصل بنا</a>
			</div>
		</div>
	</div>
</footer>
